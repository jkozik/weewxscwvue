# Live config holds the station's DDNS host/port (and any future secrets);
# data/weewx.conf.example is the tracked template.
data/weewx.conf
data/weewx.conf.*
!data/weewx.conf.example
data/archive/
data/public_html/
# Generated WeeWX-Saratoga output (FTP'd to new.sancapweather.com)
data/saratoga_html/
# DivumWX web folder: static files fetched by divumwx-assets, jsondata/ written by weewx
data/divumwx/
data/bin/user/__pycache__/
data/bin/user/installer/
data/examples/
data/scripts/
data/util/
*.swp
*.log
*.pre-*
*.backup
.claude/
# Mosquitto: password file and runtime state are not tracked
mosquitto/config/passwd
mosquitto/config/acl
mosquitto/data/

